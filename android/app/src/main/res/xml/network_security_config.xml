<?xml version="1.0" encoding="utf-8"?>
<!-- Allow cleartext HTTP to local Ollama / Tailscale / LAN IPs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
